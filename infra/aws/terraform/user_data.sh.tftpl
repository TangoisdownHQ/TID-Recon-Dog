#!/bin/bash
set -eux

# --- Docker + compose plugin ------------------------------------------------
dnf update -y
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/libexec/docker/cli-plugins
curl -sSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# --- Free port 22 for the fake SSH; move the host's real sshd to 2200 -------
# (Primary admin access is AWS SSM Session Manager, which needs no inbound port.)
sed -i 's/^#\?Port .*/Port 2200/' /etc/ssh/sshd_config
systemctl restart sshd || true

# --- Compose file: real well-known ports -> container ports -----------------
cat >/opt/tid-compose.yml <<'YML'
services:
  honeypot:
    image: ${image_uri}
    restart: unless-stopped
    command: ${jsonencode(concat(["node", "dist/index.js", "start"], split(" ", services)))}
    ports:
%{ for p in ports_tcp ~}
      - "${p.host}:${p.container}"
%{ endfor ~}
%{ if udp_snmp ~}
      - "161:16100/udp"
%{ endif ~}
      - "${operator_publish}"   # operator plane
    environment:
      - OPERATOR_HOST=0.0.0.0
      - OPERATOR_PORT=9090
      - OPERATOR_TOKEN=${operator_token}
      - NODE_NAME=${node_name}
      - NODE_REGION=${node_region}
      - NODE_PORTS=${node_ports}
      - NODE_SERVICES=${services}
%{ if fleet_master_url != "" ~}
      - FLEET_MASTER_URL=${fleet_master_url}
      - FLEET_TOKEN=${fleet_token}
%{ endif ~}
%{ if telegram_bot_token != "" ~}
      - TELEGRAM_BOT_TOKEN=${telegram_bot_token}
      - TELEGRAM_CHAT_ID=${telegram_chat_id}
%{ endif ~}
%{ if threat_feeds != "" ~}
      - THREAT_FEEDS=${threat_feeds}
%{ endif ~}
%{ if threat_feeds_autoblock ~}
      - THREAT_FEEDS_AUTOBLOCK=true
%{ endif ~}
%{ if darkweb_feeds != "" ~}
      - DARKWEB_FEEDS=${darkweb_feeds}
%{ endif ~}
%{ if darkweb_news_feeds != "" ~}
      - DARKWEB_NEWS_FEEDS=${darkweb_news_feeds}
%{ endif ~}
%{ if darkweb_proxy != "" ~}
      - DARKWEB_PROXY=${darkweb_proxy}
%{ endif ~}
%{ if ai_model_url != "" ~}
      - AI_MODEL_URL=${ai_model_url}
      - AI_MODEL=${ai_model}
%{ endif ~}
    volumes:
      - tid-runtime:/app/runtime
      - tid-logs:/app/logs
      - tid-uploads:/app/uploads
volumes:
  tid-runtime:
  tid-logs:
  tid-uploads:
YML

# --- Start script (idempotent; self-heals; waits for the image to be pushed) -
cat >/usr/local/bin/tid-start.sh <<'SH'
#!/bin/bash
set -e
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}
docker compose -f /opt/tid-compose.yml pull
docker compose -f /opt/tid-compose.yml up -d
SH
chmod +x /usr/local/bin/tid-start.sh

cat >/etc/systemd/system/tid.service <<'UNIT'
[Unit]
Description=TID-Recon-Dog honeypot
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/tid-start.sh
UNIT

# Retry every minute until the ECR image exists, then keep self-healing.
cat >/etc/systemd/system/tid.timer <<'UNIT'
[Unit]
Description=Start/refresh TID-Recon-Dog honeypot
[Timer]
OnBootSec=20s
OnUnitActiveSec=60s
[Install]
WantedBy=timers.target
UNIT

# --- Auto-heal: restart the container if the operator plane wedges -----------
# Marks the restart reason in the runtime volume so the Fleet tab can show WHY.
cat >/usr/local/bin/tid-autoheal.sh <<'SH'
#!/bin/sh
FAILS=/tmp/tid_health_fails
CODE=$(curl -s --max-time 8 -o /dev/null -w "%%{http_code}" http://127.0.0.1:9090/healthz 2>/dev/null)
if [ "$CODE" = "200" ]; then echo 0 > "$FAILS"; exit 0; fi
N=$(cat "$FAILS" 2>/dev/null || echo 0); N=$((N+1)); echo "$N" > "$FAILS"
logger -t tid-autoheal "healthz=$CODE consecutive-fail=$N"
if [ "$N" -ge 3 ]; then
  logger -t tid-autoheal "restarting honeypot after $N failures"
  docker run --rm -v opt_tid-runtime:/r alpine sh -c 'echo autoheal > /r/.autoheal-restart' 2>/dev/null || true
  docker compose -f /opt/tid-compose.yml restart >/dev/null 2>&1
  echo 0 > "$FAILS"
fi
SH
chmod +x /usr/local/bin/tid-autoheal.sh
cat >/etc/systemd/system/tid-autoheal.service <<'UNIT'
[Unit]
Description=TID auto-heal (restart if operator healthz down)
[Service]
Type=oneshot
ExecStart=/usr/local/bin/tid-autoheal.sh
UNIT
cat >/etc/systemd/system/tid-autoheal.timer <<'UNIT'
[Unit]
Description=Run TID auto-heal every minute
[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
[Install]
WantedBy=timers.target
UNIT

# --- Backup: archive runtime + logs volumes to S3 daily ----------------------
%{ if backup_bucket != "" ~}
cat >/usr/local/bin/tid-backup.sh <<'SH'
#!/bin/sh
set -e
TS=$(date -u +%Y%m%dT%H%M%SZ)
DEST=s3://${backup_bucket}/nodes/${node_name}/$TS
TMP=$(mktemp -d)
for V in opt_tid-runtime opt_tid-logs; do
  docker run --rm -v $V:/src:ro -v $TMP:/out alpine tar czf /out/$V.tgz -C /src . 2>/dev/null || true
done
aws s3 cp "$TMP"/ "$DEST"/ --recursive --region ${region} >/dev/null 2>&1 && \
  logger -t tid-backup "backed up to $DEST" || logger -t tid-backup "backup FAILED to $DEST"
rm -rf "$TMP"
SH
chmod +x /usr/local/bin/tid-backup.sh
cat >/etc/systemd/system/tid-backup.service <<'UNIT'
[Unit]
Description=TID backup runtime+logs to S3
[Service]
Type=oneshot
ExecStart=/usr/local/bin/tid-backup.sh
UNIT
cat >/etc/systemd/system/tid-backup.timer <<'UNIT'
[Unit]
Description=Daily TID S3 backup
[Timer]
OnBootSec=1h
OnUnitActiveSec=24h
Persistent=true
[Install]
WantedBy=timers.target
UNIT
%{ endif ~}

systemctl daemon-reload
systemctl enable --now tid.timer
systemctl enable --now tid-autoheal.timer
%{ if backup_bucket != "" ~}
systemctl enable --now tid-backup.timer
%{ endif ~}
